+                                job_id: Optional[str] = None, due_at: Optional[str] = None,
+                                force: bool = False) -> Tuple[bool, dict, Optional[str]]:
+    """§12 原子抢占：文件锁临界区内 CAS dispatch（not_attempted/retry_wait/dead → queued）。
